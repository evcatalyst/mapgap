{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapGap local fixture subset of Google GenerateIsochroneResponse",
  "description": "Locally authored fixture validation subset; verify actual live output before production. Topology, winding and closed-ring checks are additional semantic checks.",
  "$comment": "https://developers.google.com/maps/documentation/isochrones/reference/rest/v1/isochrones/generate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "isochrone"
  ],
  "properties": {
    "isochrone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geoJson"
      ],
      "properties": {
        "geoJson": {
          "oneOf": [
            {
              "$ref": "#/$defs/polygon"
            },
            {
              "$ref": "#/$defs/multiPolygon"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "polygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ring"
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "$ref": "#/$defs/polygonCoordinates"
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/polygonCoordinates"
          }
        }
      }
    }
  }
}
