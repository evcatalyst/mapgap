{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapGap local fixture subset of Google GenerateIsochroneRequest",
  "description": "Locally authored from the published REST reference, not an official Google schema. Enforce positive duration and per-mode upper bounds separately.",
  "$comment": "https://developers.google.com/maps/documentation/isochrones/reference/rest/v1/isochrones/generate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "travelDuration",
    "travelMode",
    "travelDirection"
  ],
  "oneOf": [
    {
      "required": [
        "location"
      ],
      "not": {
        "required": [
          "place"
        ]
      }
    },
    {
      "required": [
        "place"
      ],
      "not": {
        "required": [
          "location"
        ]
      }
    }
  ],
  "properties": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "place": {
      "type": "string",
      "pattern": "^places/[^/\\s]+$"
    },
    "travelDuration": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,9})?s$"
    },
    "travelMode": {
      "enum": [
        "DRIVE",
        "BICYCLE",
        "WALK",
        "TWO_WHEELER"
      ]
    },
    "travelDirection": {
      "enum": [
        "FROM",
        "TO"
      ]
    },
    "routingPreference": {
      "enum": [
        "TRAFFIC_UNAWARE",
        "TRAFFIC_AWARE",
        "ROUTING_PREFERENCE_UNSPECIFIED"
      ]
    },
    "enableSmoothing": {
      "type": "boolean"
    },
    "polygonFidelity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "POLYGON_FIDELITY_UNSPECIFIED"
      ]
    }
  }
}
